<?xml version="1.0" encoding="utf-8" ?>
<pages:BasePage
    x:Class="FareNexDriverApp.Views.EndTripPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:FareNexDriverApp.Views.BasePages"
    xmlns:resx="clr-namespace:FareNexDriverApp.Resources.Strings"
    xmlns:viewModels="clr-namespace:FareNexDriverApp.Core.ViewModels;assembly=FareNexDriverApp.Core"
    xmlns:views="clr-namespace:FareNexDriverApp.Views.CommonViews"
    x:DataType="viewModels:EndTripPageViewModel"
    BackgroundColor="{StaticResource PageBGColor}">

    <Grid ColumnDefinitions="*" RowDefinitions="Auto,*">

        <Image
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Margin="0,12,0,0"
            Aspect="AspectFit"
            HeightRequest="140"
            HorizontalOptions="Center"
            Source="express_shuttle_logo.png"
            VerticalOptions="Center"
            WidthRequest="200" />

        <ImageButton
            Grid.Row="0"
            Grid.Column="1"
            Margin="0,42,65,0"
            HeightRequest="39"
            HorizontalOptions="End"
            IsVisible="False"
            Source="options_icon.png"
            VerticalOptions="Start"
            WidthRequest="39" />

        <Border
            Grid.Row="1"
            Margin="65,0,65,0"
            BackgroundColor="White">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="30,30,0,0" />
            </Border.StrokeShape>

            <Grid
                Margin="90,80,90,0"
                ColumnDefinitions="*,*"
                RowDefinitions="Auto,Auto,Auto"
                RowSpacing="30">

                <Label
                    Grid.Row="0"
                    Grid.ColumnSpan="2"
                    HorizontalOptions="Center"
                    Style="{StaticResource SemiBoldDarkGrayH4LabelStyle}"
                    Text="{x:Static resx:AppResources.Comprehensive_Trip_Disc}"
                    VerticalOptions="Center" />

                <Border
                    Grid.Row="1"
                    Grid.ColumnSpan="3"
                    HeightRequest="223"
                    StrokeThickness="2">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>

                    <Grid
                        Margin="20,14,24,10"
                        ColumnDefinitions="25*,Auto,50*,Auto,25*"
                        RowDefinitions="Auto,Auto,*">

                        <Label
                            Grid.Row="0"
                            Grid.Column="0"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center"
                            Style="{StaticResource BoldGray450BodyLabelStyle}"
                            Text="{x:Static resx:AppResources.BusNumber}"
                            VerticalOptions="Center"
                            VerticalTextAlignment="Center" />

                        <Label
                            Grid.Row="0"
                            Grid.Column="2"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center"
                            Style="{StaticResource BoldGray450BodyLabelStyle}"
                            Text="{x:Static resx:AppResources.Route}"
                            VerticalOptions="Center" />

                        <Label
                            Grid.Row="0"
                            Grid.Column="3"
                            Grid.ColumnSpan="2"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center"
                            Style="{StaticResource BoldGray450BodyLabelStyle}"
                            Text="{x:Static resx:AppResources.DrivenMiles}"
                            VerticalOptions="Center" />

                        <BoxView
                            Grid.Row="1"
                            Grid.ColumnSpan="5"
                            Margin="0,10"
                            HeightRequest="2"
                            Style="{StaticResource BoxView}" />

                        <Label
                            Grid.Row="2"
                            Grid.Column="0"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center"
                            Style="{StaticResource BoldRedH3LabelStyle}"
                            Text="{Binding BusNumber}"
                            VerticalTextAlignment="Center" />

                        <BoxView
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="24,0,0,0"
                            HeightRequest="100"
                            Style="{StaticResource BoxView}"
                            WidthRequest="2" />

                        <Label
                            Grid.Row="2"
                            Grid.Column="2"
                            Margin="20,0"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center"
                            Style="{StaticResource MediumRedH6LabelStyle}"
                            Text="{Binding SelectedRoute}"
                            VerticalOptions="Center"
                            VerticalTextAlignment="Center" />

                        <BoxView
                            Grid.Row="2"
                            Grid.Column="3"
                            Grid.ColumnSpan="1"
                            Margin="0,0,24,0"
                            HeightRequest="100"
                            Style="{StaticResource BoxView}"
                            WidthRequest="2" />

                        <Label
                            Grid.Row="2"
                            Grid.Column="4"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center"
                            Style="{StaticResource BoldRedH3LabelStyle}"
                            Text="{Binding DrivenMiles}"
                            VerticalOptions="Center"
                            VerticalTextAlignment="Center" />

                    </Grid>

                </Border>

                <Button
                    Grid.Row="2"
                    Grid.Column="0"
                    Command="{Binding GoBackCommand}"
                    HorizontalOptions="Start"
                    Style="{StaticResource CancelButtonStyle}"
                    Text="{x:Static resx:AppResources.GoBack}" />

                <!--  Start Ride Button  -->
                <Button
                    Grid.Row="2"
                    Grid.Column="2"
                    Command="{Binding EndRideCommand}"
                    HorizontalOptions="End"
                    Style="{StaticResource OkButtonStyle}"
                    Text="{x:Static resx:AppResources.EndRide}" />
            </Grid>
        </Border>
        <views:InternetView />

    </Grid>

</pages:BasePage>

